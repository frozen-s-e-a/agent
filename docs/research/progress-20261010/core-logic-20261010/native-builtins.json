{
  "features": [
    {
      "name": "跨月编制",
      "tool": "日期_计算月差",
      "source_cols": "制单日期,凭证日期",
      "param": null
    },
    {
      "name": "凭证月份",
      "tool": "日期_提取月份",
      "source_cols": "凭证日期",
      "param": null
    },
    {
      "name": "制单小时数",
      "tool": "日期_提取小时",
      "source_cols": "制单时间",
      "param": null
    },
    {
      "name": "是否周末",
      "tool": "日期_判断周末",
      "source_cols": "凭证日期",
      "param": null
    },
    {
      "name": "借方余数",
      "tool": "数值_求余数",
      "source_cols": "借方金额",
      "param": "10000"
    },
    {
      "name": "贷方余数",
      "tool": "数值_求余数",
      "source_cols": "贷方金额",
      "param": "10000"
    },
    {
      "name": "尾数后3位",
      "tool": "文本_提取后几位",
      "source_cols": "借方金额,贷方金额",
      "param": "3"
    },
    {
      "name": "摘要长度",
      "tool": "文本_计算长度",
      "source_cols": "摘要",
      "param": null
    },
    {
      "name": "凭证差额",
      "tool": "统计_分组求和差额",
      "source_cols": "凭证日期,类型,编号",
      "param": "借方金额,贷方金额"
    },
    {
      "name": "科目频率",
      "tool": "统计_组内计数",
      "source_cols": "科目编码",
      "param": null
    },
    {
      "name": "制单人频率",
      "tool": "统计_组内计数",
      "source_cols": "制单人",
      "param": null
    },
    {
      "name": "行重复",
      "tool": "逻辑_行内容重复",
      "source_cols": null,
      "param": null
    },
    {
      "name": "制单审核一致",
      "tool": "逻辑_对比两列相同",
      "source_cols": "制单人,审核人",
      "param": null
    }
  ],
  "rules": [
    {
      "name": "非法科目代码",
      "conditions": {
        "科目编码": "!^1,!^2,!^3,!^4,!^5,!^6"
      }
    },
    {
      "name": "跨期冲回(摘要)",
      "conditions": {
        "摘要": "冲回,跨期,以前年度"
      }
    },
    {
      "name": "跨期冲回(跨月)",
      "conditions": {
        "跨月编制": ">=2"
      }
    },
    {
      "name": "期末收入突击",
      "conditions": {
        "凭证月份": "12",
        "借方金额": ">1000000",
        "科目编码": "^6001,^6051"
      }
    },
    {
      "name": "准备类借方异常",
      "conditions": {
        "借方金额": ">0",
        "科目编码": "^1231"
      },
      "alias_subject": "坏账准备"
    },
    {
      "name": "准备类贷方异常",
      "conditions": {
        "贷方金额": ">0",
        "科目名称": "坏账准备"
      }
    },
    {
      "name": "期末费用调整(借)",
      "conditions": {
        "凭证月份": "12",
        "借方金额": "<=-50000",
        "科目编码": "^6601,^6602,^6603"
      }
    },
    {
      "name": "期末费用调整(贷)",
      "conditions": {
        "凭证月份": "12",
        "贷方金额": ">=50000",
        "科目编码": "^6601,^6602,^6603",
        "摘要": "调整"
      }
    },
    {
      "name": "重大损益调整",
      "conditions": {
        "凭证月份": "12",
        "借方金额": ">100000",
        "科目编码": "^6"
      }
    },
    {
      "name": "不常用账户",
      "conditions": {
        "科目频率": "<=2"
      }
    },
    {
      "name": "偶尔制单人员",
      "conditions": {
        "制单人频率": "<=10"
      }
    },
    {
      "name": "高管越权制单",
      "conditions": {
        "制单人": "王总,CFO"
      }
    },
    {
      "name": "结账后分录",
      "conditions": {
        "凭证月份": ">12"
      }
    },
    {
      "name": "借方大额整万",
      "conditions": {
        "借方余数": "0",
        "借方金额": ">1000000"
      }
    },
    {
      "name": "贷方大额整万",
      "conditions": {
        "贷方余数": "0",
        "贷方金额": ">1000000"
      }
    },
    {
      "name": "特殊尾数999",
      "conditions": {
        "尾数后3位": "999,950"
      }
    },
    {
      "name": "重大估计调整(借)",
      "conditions": {
        "借方金额": ">1000000",
        "摘要": "估计,暂估"
      }
    },
    {
      "name": "重大估计调整(贷)",
      "conditions": {
        "贷方金额": ">1000000",
        "摘要": "估计,暂估"
      }
    },
    {
      "name": "未调节差异",
      "conditions": {
        "摘要": "差异,未达"
      }
    },
    {
      "name": "集团内部交易",
      "conditions": {
        "科目编码": "^1122",
        "摘要": "关联方,集团"
      }
    },
    {
      "name": "深夜分录",
      "conditions": {
        "制单小时数": ">22,<7"
      }
    },
    {
      "name": "周末分录",
      "conditions": {
        "是否周末": "是"
      }
    },
    {
      "name": "摘要重分类",
      "conditions": {
        "摘要": "重分类"
      }
    },
    {
      "name": "指示编制",
      "conditions": {
        "摘要": "指示,要求"
      }
    },
    {
      "name": "借方负数",
      "conditions": {
        "借方金额": "<0"
      }
    },
    {
      "name": "贷方负数",
      "conditions": {
        "贷方金额": "<0"
      }
    },
    {
      "name": "借贷不平",
      "conditions": {
        "凭证差额": ">0.01"
      }
    },
    {
      "name": "重复分录",
      "conditions": {
        "行重复": "是"
      }
    },
    {
      "name": "日期无效",
      "conditions": {
        "凭证月份": "[空]"
      }
    },
    {
      "name": "零余额账户",
      "conditions": {
        "借方金额": "0",
        "贷方金额": "0"
      }
    },
    {
      "name": "无编制人",
      "conditions": {
        "制单人": "[空]"
      }
    },
    {
      "name": "同人审单",
      "conditions": {
        "制单审核一致": "是"
      }
    },
    {
      "name": "无解释分录",
      "conditions": {
        "摘要长度": "<2"
      }
    }
  ],
  "tools": [
    {
      "name": "日期_计算月差",
      "description": "计算两个日期列的月份差",
      "needs": "2个日期列",
      "param": null
    },
    {
      "name": "日期_判断周末",
      "description": "判断日期是否为周末",
      "needs": "1个日期列",
      "param": null
    },
    {
      "name": "日期_提取月份",
      "description": "提取日期的月份",
      "needs": "1个日期列",
      "param": null
    },
    {
      "name": "日期_提取小时",
      "description": "提取时间的小时数",
      "needs": "1个时间列",
      "param": null
    },
    {
      "name": "数值_求余数",
      "description": "对数值求余数",
      "needs": "1个数值列",
      "param": "除数(如10000)"
    },
    {
      "name": "文本_提取后几位",
      "description": "提取数字的后N位",
      "needs": "1个数值列",
      "param": "位数(如3)"
    },
    {
      "name": "文本_计算长度",
      "description": "计算文本长度",
      "needs": "1个文本列",
      "param": null
    },
    {
      "name": "逻辑_对比两列相同",
      "description": "判断两列是否相同",
      "needs": "2个列",
      "param": null
    },
    {
      "name": "统计_组内计数",
      "description": "按列值分组计数",
      "needs": "1个列",
      "param": null
    },
    {
      "name": "统计_分组求和差额",
      "description": "按分组列对两个数值列求和并计算差额",
      "needs": "分组列",
      "param": "2个数值列"
    },
    {
      "name": "逻辑_行内容重复",
      "description": "判断行内容是否重复",
      "needs": "可选列名",
      "param": null
    }
  ]
}